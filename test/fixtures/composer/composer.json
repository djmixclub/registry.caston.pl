{
    "name": "acme/http-client",
    "description": "A small PSR-18 HTTP client with retry and caching middleware.",
    "type": "library",
    "keywords": ["http", "psr-18", "client", "middleware"],
    "homepage": "https://github.com/acme/http-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/acme/http-client/issues",
        "source": "https://github.com/acme/http-client"
    },
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "nyholm/psr7": "^1.8"
    },
    "provide": {
        "psr/http-client-implementation": "1.0"
    },
    "suggest": {
        "psr/simple-cache-implementation": "Enables the caching middleware"
    },
    "autoload": {
        "psr-4": {
            "Acme\\HttpClient\\": "src/"
        },
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\HttpClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
