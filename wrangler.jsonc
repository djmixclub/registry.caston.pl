// Serverless Registry Worker. Nothing installation-specific belongs in this file (no account,
// namespace or bucket IDs, no domain, no secrets), so updates merge without conflicts.
// See docs/deployment.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "registry-caston-pl",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The panel's CSS, script and icon, served by Workers Static Assets without running the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Bindings carry no IDs: Wrangler provisions them or matches them by name on deploy.
  // AUTH: credentials, the gh-repo: index, schema_version and short-lived caches.
  "kv_namespaces": [
    {
      "binding": "AUTH",
      "id": "ba4f2a814b6644868c3e48e1b16a9963"
    }
  ],
  // R2_BUCKET: package files, version manifests (the source of truth), indexes and staging.
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "registry-caston-pl"
    }
  ],
  // Hourly cleanup of uncommitted uploads and expired secrets.
  "triggers": { "crons": ["0 * * * *"] },
  // Installation settings live in the dashboard (Settings -> Variables and Secrets) or come from
  // `wrangler secret put`, never from this file. Required: PUBLIC_URL (https://packages.example.com),
  // S3_ENDPOINT (https://<account-id>.r2.cloudflarestorage.com), S3_ACCESS_KEY_ID and
  // S3_SECRET_ACCESS_KEY (an R2 API token for this bucket only), and SESSION_SECRET, a long random
  // string (e.g. `openssl rand -base64 48`) that signs panel session cookies. Add the credentials
  // and SESSION_SECRET as secrets; PUBLIC_URL and S3_ENDPOINT may be plain variables.
  // Optional overrides, with their defaults in src/core/config.ts: ECOSYSTEMS (all seven),
  // MAX_UPLOAD_BYTES (536870912), APPEND_WINDOW_HOURS (24), TOKEN_PREFIX (empty), CHECK_UPDATES
  // (true) and R2_BUCKET_NAME (serverless-registry, must equal `bucket_name` above: presigned URLs
  // address the bucket by name). See .dev.vars.example and docs/deployment.md.
  // There is deliberately no `vars` block: Wrangler re-applies every value in `vars` on deploy.
  // keep_vars: deploys keep the plain-text variables set in the dashboard instead of deleting them.
  "keep_vars": true,
  // Workers Logs in the dashboard.
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "registry.caston.pl",
      "custom_domain": true
    }
  ],
}
