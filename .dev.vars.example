# Installation settings. Copy to .dev.vars for `npm run dev`; in production set them in the
# Worker's Settings -> Variables and Secrets (the deploy button's setup page asks for them).
# The registry's public address, without a trailing slash.
PUBLIC_URL=https://packages.example.com
# The R2 S3 API endpoint of your account, without the bucket name.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Access key ID of an R2 API token with Object Read & Write on the registry's bucket only.
S3_ACCESS_KEY_ID=<r2-access-key-id>
# Secret access key of that R2 API token.
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Signs panel session cookies; a long random string, e.g. `openssl rand -base64 48`.
SESSION_SECRET=<long-random-string>
